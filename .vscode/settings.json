{
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "[swift]": {
    "editor.tabSize": 4
  },
  "sourcekit-lsp.serverPath": "/usr/bin/sourcekit-lsp",
  "files.exclude": {
    "bin/": true,
    "**/*.dSYM": true,
    ".DS_Store": true
  },
  "search.exclude": {
    "bin/": true,
    "tests/*.png": true
  }
}
